NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot_ai

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# AI — Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# Recommended free model on Groq. Change without touching business logic.
GROQ_MODEL=llama-3.1-8b-instant

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Per-user daily AI limits (set to 0 to disable a feature)
AI_LIMIT_RESUME_ANALYSIS=5
AI_LIMIT_JD_ANALYSIS=10
AI_LIMIT_TAILORING=5
AI_LIMIT_MATCH_EXPLANATION=20
